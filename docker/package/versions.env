# Versions pinned by the standalone packaging flow.
#
# Environment variables of the same name override these defaults.
#
# The Rust binaries in this repository are a port of this Sourcegraph baseline
# and serve the web bundle built from the same source tree. The public
# snapshot repository is the readable copy of the baseline (the old
# sourcegraph/sourcegraph URL is no longer anonymously accessible).
: "${SOURCEGRAPH_VERSION:=5.5.0}"
: "${SOURCEGRAPH_COMMIT:=c864f15af264f0f456a6d8a83290b5c940715349}"
: "${SOURCEGRAPH_REPO:=https://github.com/sourcegraph/sourcegraph-public-snapshot.git}"

# Root filesystem distribution ("other open-source components").
: "${UBUNTU_SUITE:=noble}"
: "${UBUNTU_MIRROR:=http://archive.ubuntu.com/ubuntu}"

# Rust profile used for the service binaries in the image.
: "${CARGO_PROFILE:=release}"

# Sourcegraph's patched universal-ctags (`--_interactive` protocol) used by
# the symbols service for languages that scip-ctags does not cover (C/C++,
# Markdown, ...). Pinned to the same build as `dev/tool_deps.bzl`
# (`universal-ctags-linux-amd64`).
: "${UNIVERSAL_CTAGS_VERSION:=6.0.0.2783f009}"
: "${UNIVERSAL_CTAGS_URL:=https://storage.googleapis.com/universal_ctags/x86_64-linux/dist/universal-ctags-${UNIVERSAL_CTAGS_VERSION}}"
: "${UNIVERSAL_CTAGS_SHA256:=e99b942754ce9d55c9445513236c010753d26decbb38ed932780bec098ac0809}"
